@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary: #7c3aed;
    --secondary: #db2777;
    --accent: #06b6d4;
    --success: #10b981;
    --danger: #ef4444;
    --dark: #1e1b4b;
    --light: #f5f3ff;
}

body {
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(135deg, #f5f3ff 0%, #fce7f3 50%, #e0f2fe 100%);
    min-height: 100vh;
}

/* ─── NAVBAR ─── */
.navbar {
    background: linear-gradient(135deg, var(--dark), #4c1d95) !important;
    box-shadow: 0 4px 20px rgba(124, 58, 237, 0.3);
    padding: 12px 24px;
}

.navbar-brand {
    font-weight: 700;
    font-size: 1.5rem;
    color: #fff !important;
    letter-spacing: 1px;
}

.navbar-brand span {
    color: #f472b6 !important;
}

/* ─── SIDEBAR ─── */
.sidebar {
    min-height: calc(100vh - 60px);
    background: linear-gradient(180deg, #1e1b4b 0%, #4c1d95 100%);
    padding-top: 24px;
    box-shadow: 4px 0 15px rgba(0,0,0,0.1);
}

.sidebar .nav-link {
    color: #c4b5fd !important;
    padding: 12px 20px;
    border-radius: 10px;
    margin: 4px 12px;
    font-weight: 500;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 10px;
}

.sidebar .nav-link:hover {
    background: linear-gradient(135deg, #7c3aed, #db2777);
    color: #fff !important;
    transform: translateX(5px);
    box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4);
}

.sidebar .nav-link.active {
    background: linear-gradient(135deg, #7c3aed, #db2777);
    color: #fff !important;
    box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4);
}

/* ─── MAIN CONTENT ─── */
.main-content {
    padding: 32px;
}

/* ─── CARDS ─── */
.card {
    border: none !important;
    border-radius: 16px !important;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08) !important;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    overflow: hidden;
}

.card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(124, 58, 237, 0.15) !important;
}

/* ─── STAT CARDS ─── */
.stat-card-blue {
    background: linear-gradient(135deg, #7c3aed, #6d28d9);
    color: white;
    border-radius: 16px;
    padding: 24px;
    text-align: center;
}

.stat-card-pink {
    background: linear-gradient(135deg, #db2777, #be185d);
    color: white;
    border-radius: 16px;
    padding: 24px;
    text-align: center;
}

.stat-card-teal {
    background: linear-gradient(135deg, #0891b2, #06b6d4);
    color: white;
    border-radius: 16px;
    padding: 24px;
    text-align: center;
}

.stat-card-blue:hover,
.stat-card-pink:hover,
.stat-card-teal:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.2) !important;
}

/* ─── BUTTONS ─── */
.btn-primary {
    background: linear-gradient(135deg, #7c3aed, #db2777) !important;
    border: none !important;
    border-radius: 10px !important;
    font-weight: 600 !important;
    padding: 10px 24px !important;
    transition: all 0.3s ease !important;
    box-shadow: 0 4px 15px rgba(124, 58, 237, 0.3) !important;
}

.btn-primary:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 20px rgba(124, 58, 237, 0.5) !important;
}

.btn-success {
    background: linear-gradient(135deg, #059669, #10b981) !important;
    border: none !important;
    border-radius: 10px !important;
    font-weight: 600 !important;
    transition: all 0.3s ease !important;
}

.btn-success:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4) !important;
}

.btn-secondary {
    background: linear-gradient(135deg, #6b7280, #4b5563) !important;
    border: none !important;
    border-radius: 10px !important;
    font-weight: 600 !important;
}

.btn-outline-danger {
    border-radius: 10px !important;
    font-weight: 500 !important;
    transition: all 0.3s ease !important;
}

/* ─── FORMS ─── */
.form-control {
    border-radius: 10px !important;
    border: 2px solid #e9d5ff !important;
    padding: 12px 16px !important;
    font-family: 'Poppins', sans-serif !important;
    transition: all 0.3s ease !important;
}

.form-control:focus {
    border-color: #7c3aed !important;
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15) !important;
}

.form-label {
    font-weight: 600;
    color: #4c1d95;
    margin-bottom: 6px;
}

/* ─── LOGIN PAGE ─── */
.login-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1e1b4b 0%, #4c1d95 50%, #be185d 100%);
}

.login-card {
    background: white;
    border-radius: 20px !important;
    padding: 40px !important;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3) !important;
    width: 400px;
}

.login-title {
    background: linear-gradient(135deg, #7c3aed, #db2777);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 700;
    font-size: 2rem;
    text-align: center;
    margin-bottom: 8px;
}

.login-subtitle {
    text-align: center;
    color: #9ca3af;
    margin-bottom: 24px;
    font-size: 0.9rem;
}

/* ─── TABLE ─── */
.table {
    border-radius: 12px;
    overflow: hidden;
}

.table thead {
    background: linear-gradient(135deg, #7c3aed, #4c1d95);
    color: white;
}

.table thead th {
    border: none !important;
    font-weight: 600;
    padding: 14px 16px;
}

.table tbody tr {
    transition: background 0.2s ease;
}

.table tbody tr:hover {
    background: #f5f3ff !important;
}

.table tbody td {
    padding: 12px 16px;
    vertical-align: middle;
}

/* ─── BADGES ─── */
.badge {
    border-radius: 8px !important;
    padding: 6px 12px !important;
    font-weight: 600 !important;
    font-size: 0.8rem !important;
}

.bg-danger {
    background: linear-gradient(135deg, #ef4444, #dc2626) !important;
}

.bg-success {
    background: linear-gradient(135deg, #10b981, #059669) !important;
}

/* ─── ALERTS ─── */
.alert {
    border-radius: 12px !important;
    border: none !important;
    font-weight: 500;
}

.alert-success {
    background: #d1fae5 !important;
    color: #065f46 !important;
}

.alert-danger {
    background: #fee2e2 !important;
    color: #991b1b !important;
}

.alert-warning {
    background: #fef3c7 !important;
    color: #92400e !important;
}

.alert-info {
    background: #e0f2fe !important;
    color: #0c4a6e !important;
}

/* ─── PAGE TITLES ─── */
h2 {
    color: #1e1b4b;
    font-weight: 700;
}

/* ─── RESULT PAGE ─── */
.result-container {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
}

.result-image {
    border-radius: 16px !important;
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
    max-width: 350px;
    width: 100%;
}

/* ─── SCROLLBAR ─── */
::-webkit-scrollbar {
    width: 6px;
}

::-webkit-scrollbar-track {
    background: #f1f1f1;
}

::-webkit-scrollbar-thumb {
    background: linear-gradient(#7c3aed, #db2777);
    border-radius: 10px;
}